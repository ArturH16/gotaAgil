<h2 style="margin-bottom: 16px;">Seja bem vindo, doador!</h2>
{{#if erros}}
  <ul class="listaErros">
    {{#each erros}}
      <li>{{this}}</li>
    {{/each}}
  </ul>
{{/if}}
<form action="/login/doador" method="post">
        <p><strong>Email:</strong> <input class="perfilCampo campos"  type="email" name="email" placeholder="Digite seu email..."></p>
        <p><strong>Senha:</strong> <input style="margin-bottom: 20px;" class="perfilCampo campos" type="password" name="senha" placeholder="Sua senha .."></p>
        <button style="background-color: #059669; color: white; 
     margin: auto; display: block; padding: 10px; border-radius: 6px" type="submit">Logar!</button> 

</form>