<div class="detalheCampanha">
    <a href="/usuario" class="voltar" title="Voltar">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        <span>Voltar</span>
    </a>

    <div class="detalheGrid">
        <img src="{{campanha.imagem}}" alt="{{campanha.titulo}}" class="detalheImagem">

        <div class="detalheInfo">
            <div class="cardCampanhaTopo">
                <span class="badgeUrgencia {{campanha.urgenciaClasse}}">{{campanha.urgenciaRotulo}}</span>
                <span class="badgeTipoSanguineo">{{campanha.tipoSanguineo}}</span>
            </div>

            <h1>{{campanha.titulo}}</h1>

            {{#if campanha.descricao}}
                <p class="detalheDescricao">{{campanha.descricao}}</p>
            {{/if}}

            <dl class="detalheLista">
                <dt>Hemocentro</dt>
                <dd>{{hemocentro.nome}}</dd>

                <dt>Endereço</dt>
                <dd>{{hemocentro.endereco}}</dd>

                <dt>Contatos</dt>
                <dd>
                    {{#each contatos}}
                        <span>{{rotulo}}: {{#if href}}<a href="{{href}}" class="linkContato" target="_blank">{{valor}}</a>{{else}}{{valor}}{{/if}}
                    {{/each}}
                </dd>

                <dt>Encerra em</dt>
                <dd>{{campanha.dataFechamento}}</dd>
            </dl>

           {{#if campanha.encerrada}}
        <p class="campanhaEncerrada">Campanha encerrada em {{campanha.dataEncerramento}}.</p>
        {{#if campanha.jaTemInteresse}}<p class="interesseRegistrado">✓ Você demonstrou interesse nesta campanha.</p>{{/if}}
        {{else if campanha.jaTemInteresse}}
        <p class="interesseRegistrado">✓ Interesse registrado</p>
        <form method="post" action="/usuario/detalhesCampanha/{{campanha.id}}/cancelar-interesse"
            onsubmit="return confirm('Cancelar seu interesse nesta campanha?')">
            <button type="submit" class="btn-secundario">Cancelar interesse</button>
        </form>
    {{else}}
        <form method="post" action="/usuario/detalhesCampanha/{{campanha.id}}/interesse">
            <button type="submit" class="btn-interesse">Tenho interesse</button>
        </form>
    {{/if}}
        </div>
    </div>
</div>