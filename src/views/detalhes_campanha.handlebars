<div id="detalheCampanha">
    <a href="/usuario" class="voltar" title="Voltar">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        <span>Voltar</span>
    </a>

    <div class="detalheGrid">
        <img src="{{campanha.imagem}}" alt="{{campanha.titulo}}" class="detalheImagem">

        <div class="detalheInfo">
            <div class="cardCampanhaTopo">
                <span class="badgeUrgencia">{{campanha.urgencia}}</span>
                <span class="badgeTipoSanguineo">{{campanha.tipoSanguineo}}</span>
            </div>

            <h1>{{campanha.titulo}}</h1>

            {{#if campanha.descricao}}
                <p class="detalheDescricao">{{campanha.descricao}}</p>
            {{/if}}

            <dl class="detalheLista">
                <dt>Hemocentro</dt>
                <dd>{{campanha.hemocentro}}</dd>

                <dt>Endereço</dt>
                <dd>{{campanha.endereco}}</dd>

                <dt>Contatos</dt>
                <dd>
                    {{#each campanha.contatos}}
                        <span>{{this}}</span>
                    {{/each}}
                </dd>

                <dt>Encerra em</dt>
                <dd>{{campanha.dataFechamento}}</dd>
            </dl>

            {{#if campanha.encerrada}}
                <button class="btn-interesse" disabled>Campanha encerrada</button>
            {{else if jaDemonstrouInteresse}}
                <button class="btn-interesse interesse" disabled>Interesse registrado ✓</button>
            {{else}}
                <form method="POST" action="/campanha/{{campanha.id}}/interesse">
                    <button type="submit" class="btn-interesse">Tenho interesse</button>
                </form>
            {{/if}}
        </div>
    </div>
</div>