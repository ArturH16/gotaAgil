<section id="boasVindas">
    <h1>Olá, {{userName}}!</h1>
</section>
{{#if campanhas.length}}
<section id="listaCampanhas">
    {{#each campanhas}}
    <div class="cardCampanha urgencia-{{urgenciaClasse}}">
        <img src="{{fotoUrl}}" alt="" class="cardCampanhaImagem" loading="lazy">
        <div class="cardCampanhaConteudo">
            <div class="cardCampanhaTopo">
            <div class="cardCampanhaBadges">
            {{#if seuTipo}} 
            <span class="seloSeuTipo" title="Esta campanha precisa do seu tipo sanguíneo">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
                Seu tipo
            </span>{{/if}}
                <span class="badgeUrgencia {{urgenciaClasse}}">{{urgenciaRotulo}}</span>
                </div>
            <span class="badgeTipoSanguineo">{{tipoSanguineo}}</span>
            </div>
            <h3>{{nome}}</h3>
            <p class="cardCampanhaHemocentro">{{hemocentro}} · {{local}}</p>
            <p class="cardCampanhaData">Encerra em {{dataFechamento}}</p>
            <a href="/usuario/detalhesCampanha/{{id}}" class="btn-interesse">Ver campanha</a>
        </div>
    </div>
    {{/each}}
</section>
{{else}}
<p class="listaVaziaDoador">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-archive-x preview-icon"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="m9.5 17 5-5"/><path d="m9.5 12 5 5"/></svg>Nenhuma campanha aberta em {{estadoDoador}} no momento.
</p>
{{/if}}