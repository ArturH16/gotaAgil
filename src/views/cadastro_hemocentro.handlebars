    <p>Bairro: <input class="campos" type="text" name="bairro" placeholder="Digite o bairro..."></p>

     <p>Logradouro: <input class="campos" type="text" name="logradouro" placeholder="Digite o logradouro..."></p>
     
     <p>Número: <input class="campos" type="text" name="numero" placeholder="Digite o número do endereço...."></p>

     <p style="margin-bottom: 20px">CEP: <input class="campos" type="text" name="numero" placeholder="Digite o CEP...."></p>

     <button style="background-color: green; color: white; 
