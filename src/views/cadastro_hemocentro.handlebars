<h2 style="margin-bottom: 16px;">Seja bem vindo, Hemocentro!</h2>

{{#if erros}}
  <ul class="listaErros">
    {{#each erros}}
      <li>{{this}}</li>
    {{/each}}
  </ul>
{{/if}}

<form action="/cadastro/hemocentro" style="background-color: white; padding: 20px; border-radius: 6px;" class="formCadastro" method="post">
    <label for="nome"><strong>Nome:</strong> <input class="perfilCampo" type="text" name="nome" placeholder="Digite seu nome..." id="nome" required value="{{dados.nome}}"></label>
    
     <label for="email"><strong>Email:</strong> <input class="perfilCampo" type="email" name="email" placeholder="Digite seu email..." id="email" required value="{{dados.email}}"></label>

     <label for="senha"><strong>Senha:</strong> <input class="perfilCampo" type="password" name="senha" placeholder="Defina sua senha..." id="senha" minlength="8" maxlength="16" required></label> 

     <label for="codigoCnes"><strong>Código CNES</strong>: <input class="perfilCampo" type="number" name="codigoCnes" placeholder="Digite o código CNES..." id="codigoCnes" maxlength="7" required value="{{dados.codigoCnes}}"></label>
     
     <label for="cnpj"><strong>CNPJ:</strong> <input class="perfilCampo" type="text" name="cnpj" placeholder="Sem traços e pontos" id="cnpj" required value="{{dados.cnpj}}"></label> 
    
    <label for="estado"> 
        <strong>Estado: </strong> </label>
         <select name="estado" id="estado" required>
            <option {{selecionado dados.estado "AC"}} value="AC" >Acre</option>
            <option {{selecionado dados.estado "AP"}} value="AP">Amapá</option>
            <option {{selecionado dados.estado "AM"}} value="AM">Amazonas</option>
            <option {{selecionado dados.estado "PA"}} value="PA">Pará</option>
            <option {{selecionado dados.estado "RO"}} value="RO">Rondônia</option>
            <option {{selecionado dados.estado "RR"}} value="RR">Roraima</option>
            <option {{selecionado dados.estado "TO"}} value="TO">Tocantins</option>
            <option {{selecionado dados.estado "AL"}} value="AL">Alagoas</option>
            <option {{selecionado dados.estado "BA"}} value="BA">Bahia</option><option {{selecionado dados.estado "CE"}} value="CE">Ceará</option>
            <option {{selecionado dados.estado "MA"}} value="MA">Maranhão</option>
            <option {{selecionado dados.estado "PB"}} value="PB">Paraíba</option>
            <option {{selecionado dados.estado "PE"}} value="PE">Pernambuco</option>
            <option {{selecionado dados.estado "PI"}} value="PI">Piauí</option>
            <option {{selecionado dados.estado "RN"}} value="RN">Rio Grande do Norte</option>
            <option {{selecionado dados.estado "SE"}} value="SE">Sergipe</option>
            <option {{selecionado dados.estado "DF"}} value="DF">Distrito Federal</option>
            <option {{selecionado dados.estado "GO"}} value="GO">Goiás</option>
            <option {{selecionado dados.estado "MT"}} value="MT">Mato Grosso</option>
            <option {{selecionado dados.estado "MS"}} value="MS">Mato Grosso do Sul</option>
            <option {{selecionado dados.estado "ES"}} value="ES">Espírito Santo</option>
            <option {{selecionado dados.estado "MG"}} value="MG">Minas Gerais</option>
            <option {{selecionado dados.estado "RJ"}} value="RJ">Rio de Janeiro</option>
            <option {{selecionado dados.estado "SP"}} value="SP">São Paulo</option>
            <option {{selecionado dados.estado "PR"}} value="PR">Paraná</option>
            <option {{selecionado dados.estado "RS"}} value="RS">Rio Grande do Sul</option>
            <option {{selecionado dados.estado "SC"}} value="SC">Santa Catarina</option>
         </select>
    

     <label for="cidade"><strong>Cidade:</strong> <input class="perfilCampo" type="text" name="cidade" placeholder="Digite sua cidade..." id="cidade" required value="{{dados.cidade}}"></label> 

    <label for="bairro"><strong>Bairro:</strong> <input class="perfilCampo" type="text" name="bairro" placeholder="Digite o bairro..." id="bairro" required value="{{dados.cidade}}"></label>

     <label for="logradouro"><strong>Logradouro: </strong><input class="perfilCampo" type="text" name="logradouro" placeholder="Digite o logradouro..." id="logradouro" required value="{{dados.logradouro}}"></label>
     
     <label for="numero"><strong>Número:</strong> <input class="perfilCampo" type="text" name="numero" placeholder="Digite o número do endereço...." id="numero" required value="{{dados.numero}}"></label>

     <label style="margin-bottom: 20px"><strong>CEP:</strong> <input class="perfilCampo" type="text" name="cep" placeholder="Digite o CEP...." id="cep" maxlength="9" required value="{{dados.cep}}"></label>

    <div class="secao-contatos">
        <strong class="titulo-secao">Canais de Atendimento ao Doador:</strong>
        
        <div id="lista-contatos">
            {{#each dados.contatos}}
            {{> contatoItem}}
        {{/each}}
    </div>

    <template id="modelo-contato">
        {{> contatoItem tipo="whatsapp" valor=""}}
    </template>

        <button type="button" class="btn-adicionar">
            + Adicionar outro contato
        </button>
    </div>
    

     <button style="background-color: #059669; color: white; 
     margin: auto; display: block; padding: 10px; border-radius: 6px" type="submit">Cadastrar-se!</button>
</form>
<script src="/js/cadastroHemocentro.js"></script>