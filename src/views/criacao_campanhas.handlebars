{{#if erros}}
    <ul class="listaErros">
        {{#each erros}}
            <li>{{this}}</li>
        {{/each}}
    </ul>
{{/if}}

<div class="formCampanhaContainer">
    <a href="{{voltarHref}}" class="voltar" title="Voltar">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        <span>Voltar</span>
    </a>

    <h1>{{tituloForm}}</h1>

    <form method="POST" action="{{action}}" enctype="multipart/form-data" class="formCampanha">

        <div class="campoForm">
            <label for="nome">Nome da campanha</label>
            <input type="text" id="nome" name="nome" placeholder="Ex: Campanha Emergencial de Verão" required value="{{dados.nome}}">
        </div>

        <div class="campoForm">
            <label for="descricao">Descrição</label>
            <textarea id="descricao" name="descricao" rows="4" placeholder="Explique o objetivo da campanha, requisitos específicos, etc." required>{{dados.descricao}}</textarea>
        </div>

        <div class="campoFormLinha">
            <div class="campoForm">
                <label for="tipoSanguineo">Tipo sanguíneo desejado</label>
                <select id="tipoSanguineo" name="tipoSanguineo" required>
                    <option value="">Selecione</option>
                    <option value="A+" {{selecionado dados.tipoSanguineo "A+"}}>A+</option>
                    <option value="A-" {{selecionado dados.tipoSanguineo "A-"}}>A-</option>
                    <option value="B+" {{selecionado dados.tipoSanguineo "B+"}}>B+</option>
                    <option value="B-" {{selecionado dados.tipoSanguineo "B-"}}>B-</option>
                    <option value="AB+" {{selecionado dados.tipoSanguineo "AB+"}}>AB+</option>
                    <option value="AB-" {{selecionado dados.tipoSanguineo "AB-"}}>AB-</option>
                    <option value="O+" {{selecionado dados.tipoSanguineo "O+"}}>O+</option>
                    <option value="O-" {{selecionado dados.tipoSanguineo "O-"}}>O-</option>
                </select>
            </div>

            <div class="campoForm">
                <label for="urgencia">Urgência</label>
                <select id="urgencia" name="urgencia" required>
                    <option value="">Selecione</option>
                    <option value="Urgente" {{selecionado dados.urgencia "urgente"}}>Urgente</option>
                    <option value="Moderada" {{selecionado dados.urgencia "moderada"}}>Moderada</option>
                    <option value="Regular" {{selecionado dados.urgencia "regular"}}>Regular</option>
                </select>
            </div>
        </div>

         <div class="campoForm">
            <label for="dataInicio">Data de início</label>
            <input type="date" id="dataInicio" name="dataInicio" required value="{{dados.dataInicio}}">
        </div>

        <div class="campoForm">
            <label for="dataFechamento">Data de encerramento</label>
            <input type="date" id="dataFechamento" name="dataFechamento" required value="{{dados.dataFechamento}}">
        </div>

        <div class="campoForm">
            <label for="foto">Foto / flyer da campanha</label>
            {{#if fotoAtualUrl}}
                <img src="{{fotoAtualUrl}}" class="fotoAtual" alt="Foto atual da campanha">
                <small>Envie uma nova imagem se quiser trocar a atual.</small>
            {{/if}}
            <input type="file" id="foto" name="foto" accept="image/*">
            <img id="previewFoto" class="previewFoto" hidden alt="Pré-visualização da imagem">
        </div>

        <button type="submit" class="btn-interesse">{{textoBotao}}</button>
    </form>
</div>

<script src="/js/criacaoCampanha.js"></script>