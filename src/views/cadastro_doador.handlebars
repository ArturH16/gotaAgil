<h2 style="margin-bottom: 16px;">Seja bem vindo, novo doador!</h2>
<form action="" style="background-color: white; padding: 20px; border-radius: 6px;" class="formCadastro">
    <p><strong>Nome:</strong> <input class="perfilCampo campos" type="text" name="nome" placeholder="Digite seu nome..."></p>
     <p><strong>Email:</strong> <input class="perfilCampo campos" type="email" name="email" placeholder="Digite seu email..."></p>
     <p><strong>Senha:</strong> <input class="perfilCampo campos" type="password" name="senha_hash" placeholder="Defina sua senha de usuário..."></p> 

        
     
     <p><strong>CPF:</strong> <input class="perfilCampo campos" type="text" name="cpf" placeholder="Sem traços e pontos"></p> 
     
     <p><strong>Peso:</strong> <input class="perfilCampo campos" type="number" name="peso" placeholder="Seu peso em kg..." step="0.1"></p> 

      <p>
        <strong>Tipo Sanguíneo:</strong> 
         <select name="tipo_sanguineo" id="">
            <option value="A+">A+</option>
            <option value="A-">A-</option>
            <option value="B+">B+</option>
            <option value="B-">B-</option>
            <option value="AB+">AB+</option>
            <option value="AB-">AB-</option>
            <option value="O+">O+</option>
            <option value="O-">O-</option>
        </select>
        </p>

     <p>
        <strong>Estado:</strong> 
         <select name="estado" id="" >
            <option value="AC">Acre</option>
            <option value="AP">Amapá</option>
            <option value="AM">Amazonas</option>
            <option value="PA">Pará</option>
            <option value="RO">Rondônia</option>
            <option value="RR">Roraima</option>
            <option value="TO">Tocatins</option>
            <option value="AL">Alagoas</option>
            <option value="BA">Bahia</option><option value="CE">Ceará</option>
            <option value="MA">Maranhão</option>
            <option value="PB">Paraíba</option>
            <option value="PE">Pernambuco</option>
            <option value="PI">Piauí</option>
            <option value="RN">Rio Grande do Norte</option>
            <option value="SE">Sergipe</option>
            <option value="DF">Distrito Federal</option>
            <option value="GO">Goiás</option>
            <option value="MT">Mato Grosso</option>
            <option value="MS">Mato Grosso do Sul</option>
            <option value="ES">Espírito Santo</option>
            <option value="MG">Minas Gerais</option>
            <option value="RJ">Rio de Janeiro</option>
            <option value="SP">São Paulo</option>
            <option value="PR">Paraná</option>
            <option value="RS">Rio Grande do Sul</option>
            <option value="SC">Santa Catarina</option>
         </select>
     </p>
     
     <p><strong>Cidade:</strong> <input class="perfilCampo campos" type="text" name="nome" placeholder="Digite seu nome..."></p> 
     
     <p style="margin-bottom: 20px;"><strong>Data de Nascimento:</strong> <input class="perfilCampo campos" type="date" name="data_nascimento"></p>

     <button style="background-color: #059669; color: white; 
     margin: auto; display: block; padding: 10px; border-radius: 6px" type="submit">Cadastrar-se!</button>
</form>