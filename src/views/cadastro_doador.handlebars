<h2 style="margin-bottom: 16px;">Seja bem vindo, novo doador!</h2>
<form action="/cadastro/doador" style="background-color: white; padding: 20px; border-radius: 6px;" class="formCadastro" method="post">

     <label for="nome"><strong>Nome:</strong> </label>
     <input class="perfilCampo campos" type="text" name="nome" placeholder="Digite seu nome..." id="nome" required>

     <label for="email"><strong>Email:</strong> </label>
     <input class="perfilCampo campos" type="email" name="email" placeholder="Digite seu email..." id="email" required>
     
     <label for="senha"><strong>Senha:</strong></label> 
     <input class="perfilCampo campos" type="password" name="senha" placeholder="Defina sua senha.." id="senha" minlength="8" maxlength="16" required> 

        
     
     <label for="cpf"><strong>CPF:</strong> </label>
     <input class="perfilCampo campos" type="text" name="cpf" id="senha" required> 
     
     <label for="peso"><strong>Peso:</strong> </label>
     <input class="perfilCampo campos" type="number" name="peso" placeholder="Seu peso em kg..." step="0.1 " id="peso" required> 

      
        <label for="tipoSanguineo"><strong>Tipo Sanguíneo:</strong> </label>
         <select name="tipoSanguineo" id="tipoSanguineo" required>
            <option value="A+">A+</option>
            <option value="A-">A-</option>
            <option value="B+">B+</option>
            <option value="B-">B-</option>
            <option value="AB+">AB+</option>
            <option value="AB-">AB-</option>
            <option value="O+">O+</option>
            <option value="O-">O-</option>
        </select>
        

     
        <label for="estado"><strong>Estado:</strong> </label>
         <select name="estado" id="estado"required >
            <option value="AC">Acre</option>
            <option value="AP">Amapá</option>
            <option value="AM">Amazonas</option>
            <option value="PA">Pará</option>
            <option value="RO">Rondônia</option>
            <option value="RR">Roraima</option>
            <option value="TO">Tocatins</option>
            <option value="AL">Alagoas</option>
            <option value="BA">Bahia</option><option value="CE">Ceará</option>
            <option value="MA">Maranhão</option>
            <option value="PB">Paraíba</option>
            <option value="PE">Pernambuco</option>
            <option value="PI">Piauí</option>
            <option value="RN">Rio Grande do Norte</option>
            <option value="SE">Sergipe</option>
            <option value="DF">Distrito Federal</option>
            <option value="GO">Goiás</option>
            <option value="MT">Mato Grosso</option>
            <option value="MS">Mato Grosso do Sul</option>
            <option value="ES">Espírito Santo</option>
            <option value="MG">Minas Gerais</option>
            <option value="RJ">Rio de Janeiro</option>
            <option value="SP">São Paulo</option>
            <option value="PR">Paraná</option>
            <option value="RS">Rio Grande do Sul</option>
            <option value="SC">Santa Catarina</option>
         </select>
     
     
     <label for="cidade"><strong>Cidade:</strong> </label><input class="perfilCampo campos" type="text" name="cidade" placeholder="Digite sua cidade..." id="cidade" required> 
     
     <label style="margin-bottom: 20px;" for="dataNascimento"><strong>Data de Nascimento:</strong></label> 
     <input class="perfilCampo campos" type="date" name="dataNascimento" id="dataNascimento" required>

     <button style="background-color: #059669; color: white; 
     margin: auto; display: block; padding: 10px; border-radius: 6px" type="submit">Cadastrar-se!</button>
</form>