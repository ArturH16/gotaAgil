{{>flash}}
<div id="homeHemocentro">
    <section id="boasVindas">
        <h1>{{hemocentro.nome}}</h1>
        <p class="statusHemocentro {{hemocentro.status}}">{{statusRotulo}}</p>
    </section>

    <section id="minhasCampanhas">
        <div class="campanhasCabecalho">
            <h2>Minhas Campanhas</h2>
            <a href="/hemocentro/campanha/nova" class="btn-interesse btnNovaCampanha {{#if bloqueadoBotoes}}btn-desativado{{/if}}">+ Nova campanha</a>
        </div>

        <div id="filtroStatus">
            <button class="filtroBtn ativo {{#if bloqueadoBotoes}}btn-desativado{{/if}}" data-status="todas" {{#if bloqueadoBotoes}}disabled{{/if}}>Todas</button>
            <button class="filtroBtn {{#if bloqueadoBotoes}}btn-desativado{{/if}}" data-status="ativa" {{#if bloqueadoBotoes}}disabled{{/if}}>Ativas</button>
            <button class="filtroBtn {{#if bloqueadoBotoes}}btn-desativado{{/if}}" data-status="encerrada" {{#if bloqueadoBotoes}}disabled{{/if}}>Encerradas</button>
        </div>

        {{#if campanhas.length}}
            <div id="listaCampanhasHemocentro">
                {{#each campanhas}}
                <div class="cardCampanhaHemocentro" data-status="{{this.status}}">
                    <img src="{{this.fotoUrl}}" class="cardCampanhaImagem" alt="{{this.nome}}">
                    <div class="cardCampanhaTopo">
                        <span class="badgeUrgencia {{this.urgenciaLower}}">{{this.urgencia}}</span>
                        <span class="badgeTipoSanguineo">{{this.tipo_sanguineo_necessario}}</span>
                    </div>
                    <h3>{{this.nome}}</h3>
                    <p class="cardCampanhaData">Encerra em {{this.dataFechamentoFormatada}} · {{this.interessadosTexto}}</p>
                    <a href="/hemocentro/listaCampanha" class="linkSecundario {{#if ../bloqueadoBotoes}}btn-desativado{{/if}}">Ver detalhes</a>
                </div>

                {{/each}}
            </div>
        {{else}}
            <p class="listaVaziaHemocentro"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-archive-x preview-icon"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="m9.5 17 5-5"/><path d="m9.5 12 5 5"/></svg>Nenhuma campanha até o momento.</p>
        {{/if}}

        </div>
    </section>
</div>
<script src="/js/hemocentro.js"></script>
<script src="/js/flash.js"></script>